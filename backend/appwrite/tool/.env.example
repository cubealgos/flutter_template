# Copy to backend/appwrite/tool/.env.local (gitignored) and fill in — or set these as
# real environment variables instead; bin/provision.dart and bin/deploy.dart
# read both, environment variables taking precedence (see
# lib/src/backend_env.dart). Never pass these as command-line arguments.
# See backend/appwrite/README.md for the Appwrite Cloud setup.

# The Appwrite Cloud endpoint for your project's region (Frankfurt shown).
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Your Cloud project's ID (Appwrite console, or `appwrite projects list`).
APPWRITE_PROJECT_ID=

# A server API key with the scopes listed in backend/appwrite/README.md.
# The api Function itself never uses this key - it gets its own
# short-lived per-execution key from Appwrite at runtime.
APPWRITE_API_KEY=

# Optional scoped keys (see backend/appwrite/README.md "Scoped API keys"): when
# set, each command uses its own narrow key and APPWRITE_API_KEY is only the
# fallback. `dart run bin/api_keys.dart` prints how to create them.
# APPWRITE_API_KEY_PROVISIONER=
# APPWRITE_API_KEY_DEPLOYER=
# APPWRITE_API_KEY_REVIEW_DEMO_SEEDER=

# The PRODUCTION project lives in its own gitignored file,
# backend/appwrite/tool/.env.production.local, with the same three keys (and the
# optional scoped ones). It is read only when a command is run with
# --production; process environment variables are ignored for production, and a
# dev run whose APPWRITE_PROJECT_ID equals the production one is refused.

# Outgoing mail (optional). When MAIL_SMTP_HOST and MAIL_FROM are set,
# bin/provision.dart creates the Appwrite Messaging SMTP provider "mail-smtp" and
# the api Function's MAIL_* variables from them; when they are absent it skips
# mail and says so. Never commit real values.
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# MAIL_FROM=noreply@example.com
# MAIL_FROM_NAME=
# The URL a mail's unsubscribe link points at: the api Function's own domain
# plus /unsubscribe (see backend/appwrite/README.md "Email").
# MAIL_UNSUBSCRIBE_BASE_URL=https://<function-domain>/unsubscribe
